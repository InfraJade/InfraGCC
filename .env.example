# Jade GCC — every variable the compose stack reads, with its dev default.
#
# Copying this file is OPTIONAL (DECISIONS.md D3): compose.yaml / infra/docker-compose.yml use
# `${VAR:-<the value below>}`, so a clean clone runs without a .env. Copy to `.env` (repo root) only to change
# something. All values here are dev-only and obviously fake; production values come from the cloud secret
# manager, and the backend refuses APP_ENV=prod while any `dev-` value is still in use.
#
# Database passwords are applied when the timescaledb volume is first created. After changing them, reset the
# volume (`docker compose down -v`) or ALTER ROLE by hand.

# ---- General ---------------------------------------------------------------------------------------------
# Environment name for every backend service: dev | test | prod.
APP_ENV=dev
# Backend log level.
LOG_LEVEL=INFO
# Host interface that published ports bind to (0.0.0.0 to expose the stack on your LAN).
BIND_ADDRESS=127.0.0.1

# ---- Host ports ------------------------------------------------------------------------------------------
# Web app (nginx serving the React build, proxying /api and the WebSocket).
WEB_PORT=3000
# App API (REST /api/v1, WebSocket /api/v1/live, OpenAPI at /docs).
APP_API_PORT=8000
# Ingest API (collectors, token mode).
INGEST_API_PORT=8001
# Keycloak. If you change it, also change KEYCLOAK_PUBLIC_URL and OIDC_ISSUER.
KEYCLOAK_PORT=8080
# Superset web UI (container port 8088).
SUPERSET_PORT=8090
# Mailpit web UI (captured alert email).
MAILPIT_UI_PORT=8025
# BMC simulator control API (faults, Teams webhook sink).
SIM_CONTROL_HOST_PORT=9100
# TimescaleDB on the host (5432 inside the stack). 5433 avoids clashing with a local PostgreSQL.
TIMESCALE_HOST_PORT=5433
# mTLS ingest proxy (only with infra/compose.mtls.yaml).
INGEST_MTLS_PORT=8443

# ---- Database (TimescaleDB, database `gcc`) --------------------------------------------------------------
# Schema owner (POSTGRES_USER gcc_owner); used only by the migrate job and mtls-register.
GCC_OWNER_DB_PASSWORD=dev-owner-pw
# gcc_app: app API, alert worker, scheduler.
GCC_APP_DB_PASSWORD=dev-app-pw
# gcc_ingest: ingest API (writes readings, health, events, inventory).
GCC_INGEST_DB_PASSWORD=dev-ingest-pw
# gcc_superset_ro: Superset, SELECT on the reporting views only.
GCC_SUPERSET_RO_DB_PASSWORD=dev-superset-ro-pw
# superset_meta: owner of Superset's own metadata database.
SUPERSET_META_DB_PASSWORD=dev-superset-meta-pw
# keycloak: owner of Keycloak's database.
KEYCLOAK_DB_PASSWORD=dev-keycloak-db-pw
# timescaledb-tune sizing on first start (keep it laptop-sized).
TS_TUNE_MEMORY=1GB
TS_TUNE_NUM_CPUS=2
# SQLAlchemy pool per backend process.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# ---- Identity (Keycloak realm `gcc`) ---------------------------------------------------------------------
# Keycloak admin console login (http://localhost:8080/admin).
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=dev-keycloak-admin
# Public base URL of Keycloak (browser redirects and the token `iss`).
KEYCLOAK_PUBLIC_URL=http://localhost:8080
# Keycloak log level.
KEYCLOAK_LOG_LEVEL=info
# Issuer the API expects in access tokens (must match KEYCLOAK_PUBLIC_URL + /realms/gcc).
OIDC_ISSUER=http://localhost:8080/realms/gcc
# Audience the API expects in access tokens.
OIDC_AUDIENCE=gcc-api
# Where containers fetch signing keys (internal hostname, same keys as the issuer).
OIDC_JWKS_URL=http://keycloak:8080/realms/gcc/protocol/openid-connect/certs

# ---- Backend (ingest API, app API, alert worker, scheduler) ----------------------------------------------
# Collector authentication: token (dev, shared token) | mtls (prod; see infra/compose.mtls.yaml).
INGEST_AUTH_MODE=token
# Shared collector token for token mode (also given to the dev collectors as GCC_INGEST_TOKEN).
INGEST_SHARED_TOKEN=dev-ingest-token
# Key for encrypting small secrets at rest (Teams webhook URLs). Changing it makes stored routes unreadable.
APP_SECRET_KEY=dev-app-secret-key-change-me-32bytes!!
# SMTP relay for alert email (Mailpit in dev).
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM='Jade GCC Monitoring <gcc-alerts@gcc.example>'
# Superset as reached by the backend (internal) and by browsers (public).
SUPERSET_URL=http://superset:8088
SUPERSET_PUBLIC_URL=http://localhost:8090
# Superset service account the backend uses to mint guest tokens (also created by superset-init).
SUPERSET_ADMIN_USERNAME=gcc_embed
SUPERSET_ADMIN_PASSWORD=dev-superset-embed-pw
# Browser origins allowed to call the API directly (JSON list). The web container is same-origin.
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
# Public URL of the web app (links in alert email and Teams cards).
PUBLIC_APP_URL=http://localhost:3000
# Dev only: the scheduler back-fills synthetic history so charts and rollups have data on first start.
DEV_BACKFILL_ENABLED=true
DEV_BACKFILL_DAYS=7

# ---- Collectors (on-prem in production; see docs/contracts/README.md for every collector variable) ---------
# Ingest API base URL as seen from the collectors.
GCC_INGEST_URL=http://ingest-api:8001
# Credential provider: env | file | vault.
GCC_CREDENTIALS_PROVIDER=env
# Read-only Redfish account (env provider). The BMC simulator accepts the same account.
GCC_BMC_USERNAME=gcc-monitor
GCC_BMC_PASSWORD=dev-bmc-pw
# Verify BMC TLS certificates (false only for labs and simulators).
GCC_BMC_VERIFY_TLS=false
# Drop buffered batches older than this many seconds.
GCC_BUFFER_TTL_S=86400
# Collector log level.
GCC_LOG_LEVEL=INFO

# ---- BMC simulator ---------------------------------------------------------------------------------------
# Number of virtual BMCs (the dev seed onboards the same number). The load test uses 500.
SIM_COUNT=36
# BMC i listens on SIM_BASE_PORT + i inside the stack.
SIM_BASE_PORT=20000
# Random faults per BMC per hour.
SIM_FAULT_RATE=0.05
# Random seed (same seed = same serials, MACs and fault sequence).
SIM_SEED=42
# Seconds between simulation steps (drift and fault evolution).
SIM_STEP_S=10
# Simulator log level.
SIM_LOG_LEVEL=INFO

# ---- Superset --------------------------------------------------------------------------------------------
# Flask secret key for Superset sessions.
SUPERSET_SECRET_KEY=dev-superset-secret-key-change-me
# Signing key for embedded-dashboard guest tokens (5-minute tokens, RLS by site).
SUPERSET_GUEST_TOKEN_SECRET=dev-superset-guest-token-secret
# Superset admin UI login (http://localhost:8090).
SUPERSET_UI_ADMIN_USERNAME=admin
SUPERSET_UI_ADMIN_PASSWORD=dev-superset-admin
# Origins allowed to embed dashboards (comma-separated).
SUPERSET_EMBED_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Referrer allow-list stored on each embedded dashboard (comma-separated; empty = any, CSP still applies).
SUPERSET_EMBED_ALLOWED_DOMAINS=
# Superset sign-in: oauth (Keycloak SSO for analysts/admins) or db (local accounts only).
SUPERSET_AUTH=oauth
# Site codes Superset creates row-level-security roles for (GccSite_<CODE>).
SUPERSET_SITE_CODES=PNQ1,HYD1
# Weekly capacity report: recipients, schedule (cron, UTC) and sender.
SUPERSET_REPORT_RECIPIENTS=capacity-planning@gcc.example
SUPERSET_CAPACITY_REPORT_CRON='0 7 * * 1'
SUPERSET_MAIL_FROM=superset@gcc.example
# Keycloak client Superset uses for analyst SSO (secret matches infra/keycloak/gcc-realm.json).
SUPERSET_OIDC_CLIENT_ID=superset
SUPERSET_OIDC_CLIENT_SECRET=dev-superset-oidc-secret
